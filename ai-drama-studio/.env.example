# AI Drama Studio — 环境变量
#
# 该填哪些：只填你打算用的那几行，其余保持注释状态即可。
# 一个智谱 Key 就能跑通四条线里最便宜的路线（GLM-4-Flash 写剧本 +
# CogView-Flash 生图 + CogVideoX-Flash 生视频，官方都免费）。
#
# 两种填法，任选其一，也可以混用（环境变量优先于 .env 之外的来源）：
#   1) 「设置」页里填 Key 并保存 → 写 frontend/data/settings.json，后端会自动同步到本文件；
#   2) 直接改本文件 → 适合服务器部署和不想动界面的时候。
# 注意：本文件含真实 Key，已在 .gitignore 里，别提交、别贴进说明书或截图。

# ============ 剧本 / 分镜用的大模型（四条线都要） ============
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_PROVIDER=deepseek          # deepseek | openai | zhipu | custom
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ZHIPU_API_KEY=                 # 免费档，见 https://open.bigmodel.cn
# ZHIPU_LLM_MODEL=glm-4-flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============ 看关键帧用的多模态模型（片段魔改线反推原片 / 生图质检） ============
# 留空时按 VISION_API_KEY → ZHIPU_API_KEY → 上面那家剧本模型 的顺序找。
# 最后那档通常是纯文本模型，「看了等于没看」，跑魔改线前请在设置页自检里确认模型名。
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=                  # 例：gpt-4o-mini / glm-4v-flash / qwen-vl-max

# ============ 生图通道（免费优先，可多配几家自动挑） ============
# IMAGE_PROVIDER=                # 留空则按下述已配置的免费通道自动挑
# POLLINATIONS_KEY=              # 2026 起需 Key，预算制
# SILICONFLOW_API_KEY=           # 免费层 Kolors，仅生图
# GEMINI_API_KEY=                # Nano Banana
# MODELSCOPE_TOKEN=              # 魔搭每日 2000 次共享额度
# IMAGE_API_URL=                 # 自定义 OpenAI 兼容图像 API
# IMAGE_API_KEY=
# IMAGE_API_MODEL=

# ============ 生视频通道 ============
# VIDEO_PROVIDER=
# KLING_API_KEY=
# KLING_API_URL=https://api.klingai.com/v1
# ARK_API_KEY=                   # 火山方舟 Seedance：支持首尾帧、参考图，免公网隧道
# ARK_BASE_URL=
# SEEDANCE_MODEL=
# ZHIPU_VIDEO_MODEL=cogvideox-flash
# MODELSCOPE_VIDEO_MODEL=
# MODELSCOPE_BASE_URL=
# AGNES_API_KEY=                 # 2.5 Flash 限时免费；图生视频要公网 URL（见 PUBLIC_ASSET_BASE_URL）
# AGNES_BASE_URL=
# AGNES_PROXY_URL=http://127.0.0.1:57324
# AGNES_VIDEO_MODEL=agnes-video-2.5-flash
# AGNES_VIDEO_MODE=I2V           # T2V | I2V | FLF | R2V

# 整段视频编辑（片段魔改线的 video_edit 节点，出厂关闭）
# DASHSCOPE_API_KEY=             # 阿里百炼；model 用 wan2.7-videoedit
# DASHSCOPE_BASE_URL=            # 留空即 https://dashscope.aliyuncs.com
# DASHSCOPE_VIDEO_MODEL=happyhorse-1.1-i2v

# ============ 让云端能取到你本机的图片 / 源视频 ============
# 只有「云端通道 + 要吃本地图/视频」时才需要。开一条内网穿透指向后端的 8000 端口，
#   ngrok http 8000   /   cloudflared tunnel --url http://localhost:8000
# 然后把得到的公网地址填这里。纯文生视频、以及 seedance/智谱这类 base64 通道都不需要。
# PUBLIC_ASSET_BASE_URL=https://xxxx.ngrok-free.app
# ASSET_DIR=                     # 发布目录，默认 backend/static/assets

# ============ 配音 / 音乐 ============
# edge-tts 免费且无需 Key；下面两个只在想用克隆音色 / AI 歌曲时才填
# GPTSOVITS_URL=http://127.0.0.1:9880
# ACESTEP_URL=

# ============ 后期合成 ============
# ffmpeg / ffprobe 需要在 PATH 里，或者写明绝对路径（成片、烧字幕、抽帧都靠它）
# FFMPEG_BIN=D:/tools/ffmpeg.exe
# FFPROBE_BIN=D:/tools/ffprobe.exe

# ============ 存储与导出 ============
# PROJECT_STORAGE_DIR=./data/projects
# JIANYING_EXPORT_SCRIPT=        # 剪映草稿导出脚本路径（/api/export/jianying 用）
