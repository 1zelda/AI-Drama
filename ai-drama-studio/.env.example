# AI Drama Studio - Environment Configuration

# LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# DeepSeek (alternative, free tier available)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ComfyUI (local or remote)
COMFYUI_SERVER_URL=http://localhost:8188

# Video Generation APIs (optional - ComfyUI used as primary)
# KLING_API_KEY=your-kling-key
# KLING_API_URL=https://api.klingai.com/v1
# SEEDANCE_API_KEY=your-seedance-key
# VEO_API_KEY=your-veo-key

# Project storage
PROJECT_STORAGE_DIR=./data/projects