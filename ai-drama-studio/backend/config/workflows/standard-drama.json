{
  "name": "standard-drama",
  "description": "标准短剧七段流水线：剧本 → 角色资产 → 场景资产 → 分集 → 分镜 → 生图 → 生视频 → 合成。角色/场景资产只生成一次全剧复用，是保证一致性的关键。生图/生视频均可用 provider 切换本地 ComfyUI 与云端 API。",
  "version": "2.1.0",
  "nodes": {
    "script_planner": {
      "type": "llm",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "prompt_template": "plot.yaml",
      "output": "script"
    },
    "character_generator": {
      "type": "llm",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "prompt_template": "characters.yaml",
      "depends_on": [
        "script_planner"
      ],
      "output": "characters"
    },
    "character_assets": {
      "type": "image",
      "prompt": "{{image_prompt}}, character design sheet, full body, plain white background",
      "shot_type": "character_closeup",
      "workflow_file": "character-sheet.json",
      "depends_on": [
        "character_generator"
      ],
      "foreach": "characters",
      "width": 768,
      "height": 1024,
      "steps": 30,
      "cfg": 7.0,
      "output": "character_images"
    },
    "scene_generator": {
      "type": "llm",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "prompt_template": "scenes.yaml",
      "depends_on": [
        "script_planner",
        "character_generator"
      ],
      "output": "scenes"
    },
    "scene_assets": {
      "type": "image",
      "prompt": "{{image_prompt}}, no people, no text",
      "shot_type": "scene",
      "workflow_file": "scene-generation.json",
      "depends_on": [
        "scene_generator"
      ],
      "foreach": "scenes",
      "width": 1280,
      "height": 720,
      "steps": 30,
      "cfg": 7.0,
      "output": "scene_images"
    },
    "episode_planner": {
      "type": "llm",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "prompt_template": "episodes.yaml",
      "depends_on": [
        "script_planner",
        "character_generator"
      ],
      "output": "episodes"
    },
    "storyboard_generator": {
      "type": "llm",
      "provider": "deepseek",
      "model": "deepseek-chat",
      "prompt_template": "storyboard.yaml",
      "depends_on": [
        "script_planner",
        "episode_planner",
        "character_generator",
        "scene_generator"
      ],
      "output": "storyboard"
    },
    "shot_images": {
      "type": "image",
      "prompt": "{{image_prompt}}",
      "shot_type": "character_action",
      "workflow_file": "scene-generation.json",
      "depends_on": [
        "storyboard_generator",
        "character_generator",
        "scene_generator"
      ],
      "foreach": "storyboard.shots",
      "width": 1280,
      "height": 720,
      "steps": 30,
      "cfg": 7.0,
      "output": "shot_images"
    },
    "shot_videos": {
      "type": "video",
      "prompt": "{{video_prompt}}",
      "shot_type": "character_action",
      "depends_on": [
        "storyboard_generator",
        "shot_images"
      ],
      "foreach": "shot_images",
      "first_frame_from": "shot_images",
      "seconds": 5,
      "resolution": "720p",
      "output": "videos"
    },
    "video_stitch": {
      "type": "ffmpeg",
      "depends_on": [
        "shot_videos"
      ],
      "output": "final_video"
    }
  },
  "execution": {
    "parallel": true,
    "retry": 3,
    "timeout": 300
  }
}
